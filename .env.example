# On Render, set these as environment variables instead.

SUPABASE_URL=
SUPABASE_ANON_KEY=
# Server only. Bypasses RLS. Never put it in the frontend.
SUPABASE_SERVICE_KEY=
# Legacy projects that sign tokens with a shared secret (HS256). Leave empty on projects with asymmetric signing keys.
SUPABASE_JWT_SECRET=
# Optional. Default: <SUPABASE_URL>/auth/v1/.well-known/jwks.json (projects with asymmetric signing keys).
SUPABASE_JWKS_URL=

# on (default) or off. Off is for local development and tests only. Ignored on Render.
ATLAS_AUTH=

# Leave empty for normal use (the site and the API share one address). Only set it if the site is hosted elsewhere.
ATLAS_CORS_ORIGINS=